54-9762-6a6ab2665203","htmlValue":"<p>For a long time, building adaptive layouts for foldables, tablets, and desktops was complex, requiring makers to manage and switch between navigation frameworks throughout the app. To solve this, we’ve deeply integrated the Material Adaptive library with <a href=\"https://developer.android.com/guide/navigation/navigation-3?_gl=1*1qvzpce*_ga*NTY0NTY0OTE2LjE3NzkzMzg2Nzg.*_ga_QPQ2NRV856*czE3Nzk0Mzk2NzgkbzckZzEkdDE3Nzk0NDA5OTYkajYwJGwwJGgw\" target=\"_blank\">Navigation3</a>. Since the navigation library now understands the intent of your screens through metadata, it handles the heavy lifting for you, making implementation much more efficient. <a href=\"https://developer.android.com/develop/adaptive-apps\" target=\"_blank\">Build adaptive UIs with Material components today</a></p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"TEXT","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":true,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":null,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-07-07T06:03:46.849Z"}]},{"pageContentBlockId":"128d1906-fd4f-4e9e-ac42-210bed3587cb","pageContentBlockCanonId":"d5de5ee7-1fc5-4f05-907c-e3473bb89ad0","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"b4b0e91d-2302-4f5e-b01b-1d22bb20b748","pageSectionCanonId":"a268eff6-3f93-4e88-9fde-98fb29ed6855","contentChunks":[{"pageContentChunkId":"8763eb64-bb6d-4ce6-8c8a-f1ca6e9e88a8","pageContentChunkCanonId":"dcfa2b2f-5b10-4c37-9fab-e0eca87e2225","htmlValue":"","footer":"","imageUrl":null,"imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"An adaptive pane layout transitions all panes to the left when a button is selected on the rightmost pane.","videoUrl":"https://firebasestorage.googleapis.com/v0/b/design-spec/o/projects%2Fm3%2Fimages%2Fmowkgbwx-05-ADAPTIVE_REFLOW_BUILD_RENDER%20(2).mp4?alt=media","videoHeight":1080,"videoWidth":1920,"codeUrl":null,"prototypeUrl":null,"resourceName":null,"libraryModuleType":null,"moduleConfigurationOverrides":null,"contentChunkType":"VIDEO","crbHeight":500,"linkUrl":null,"openLinkUrlInNewWindow":false,"showBorderAroundMedia":false,"useSolidBackgroundOnMedia":true,"isControl":false,"captionModifier":null,"captionModifierCustomName":null,"flex":1,"autoplayVideo":true,"snippetCode":null,"snippetLanguage":null,"snippetLineNumbers":true,"updatedTimestamp":"2026-07-07T06:03:46.850Z"}]},{"pageContentBlockId":"ab21fa0a-0035-479c-bfa6-cde9f5890d0c","pageContentBlockCanonId":"36ac02f4-1e21-44a3-8083-5bec71b074d6","isHidden":false,"isSqueezed":false,"title":null,"pageSectionId":"b4b0e91d-2302-4f5e-b01b-1d22bb20b748","pageSectionCanonId":"a268eff6-3f93-4e88-9fde-98fb29ed6855","contentChunks":[{"pageContentChunkId":"af87150b-67f9-4472-98c2-a9e4d972afe5","pageContentChunkCanonId":"5e1f729a-77b8-45d9-8c4c-5255a110c4fe","htmlValue":"<h2>Migrating from Views to Compose</h2><p>We know how much you’ve built on Views, but there’s never been a better time to <a href=\"https://developer.android.com/develop/ui/compose/migrate/migrate-xml-views-to-jetpack-compose\" target=\"_blank\">migrate to Jetpack Compose</a>. Get started by migrating your apps screen-by-screen with our <a href=\"https://github.com/android/skills\" target=\"_blank\">new migration Android skill</a>, which you can use with Android Studio, Android CLI, or any other AI tool.</p><p>Stay tuned for more updates coming to Material Compose!</p>","footer":null,"imageUrl":"","imageUrlFife":null,"imageHeight":null,"imageWidth":null,"altText":"","videoUrl":null,"videoHeight":null,"videoWidth":null,"codeUrl":null,"prototype